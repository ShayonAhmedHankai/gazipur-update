{
  "name": "gazipur-update",
  "version": "1.0.0",
  "description": "Gazipur Update WordPress theme with Tailwind CSS",
  "private": true,
  "scripts": {
    "dev": "npx tailwindcss -i ./assets/css/src.css -o ./assets/css/main.css --watch",
    "build": "npx tailwindcss -i ./assets/css/src.css -o ./assets/css/main.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1",
    "@tailwindcss/typography": "^0.5.10"
  }
}
